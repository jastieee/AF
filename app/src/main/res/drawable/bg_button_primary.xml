<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FAEB92"
                android:centerColor="#FAEB92"
                android:endColor="#CC66DA" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FAEB92"
                android:endColor="#FAEB92" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>