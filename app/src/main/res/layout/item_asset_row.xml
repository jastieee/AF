<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/bg_user_list_item"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="1dp">

    <!-- ASSET NAME -->
    <TextView
        android:id="@+id/tvRowAssetName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="Treadmill"
        android:textColor="#1A1A2E"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- ASSET TAG -->
    <TextView
        android:id="@+id/tvRowAssetTag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="AF-MNL-001"
        android:textColor="#443355"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- BARCODE -->
    <TextView
        android:id="@+id/tvRowBarcode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="123456789"
        android:textColor="#443355"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- CLUB -->
    <TextView
        android:id="@+id/tvRowClub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Makati"
        android:textColor="#443355"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- TYPE -->
    <TextView
        android:id="@+id/tvRowType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="Cardio"
        android:textColor="#443355"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- STATUS badge -->
    <TextView
        android:id="@+id/tvRowStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="TAGGED"
        android:textColor="#7743DB"
        android:textSize="9sp"
        android:fontFamily="@font/bebas_neue"
        android:letterSpacing="0.06"
        android:background="@drawable/bg_role_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center" />

</LinearLayout>
