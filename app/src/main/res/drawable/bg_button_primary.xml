<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#C3ACD0"
                android:centerColor="#7743DB"
                android:endColor="#5C2DB8" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#7743DB"
                android:endColor="#5C2DB8" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
