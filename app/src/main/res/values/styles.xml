<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Field label above inputs -->
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#7743DB</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

    <!-- Container for each input field -->
    <style name="FieldWrap">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
    </style>

    <!-- EditText inside each FieldWrap -->
    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColorHint">#80443355</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
