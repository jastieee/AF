<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (Light) -->
    <style name="Theme.Anytimefitness" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#7743DB</item>
        <item name="colorPrimaryVariant">#5C2DB8</item>
        <item name="colorOnPrimary">#FFFBF5</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#C3ACD0</item>
        <item name="colorSecondaryVariant">#A890BA</item>
        <item name="colorOnSecondary">#FFFBF5</item>
        <!-- Background & surface -->
        <item name="android:colorBackground">#FFFBF5</item>
        <item name="colorSurface">#F7EFE5</item>
        <item name="colorOnBackground">#1A1A2E</item>
        <item name="colorOnSurface">#1A1A2E</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">#FFFBF5</item>
        <!-- Alert Dialog styling -->
        <item name="alertDialogTheme">@style/LightAlertDialog</item>
        <!-- Ripple color for card tap feedback -->
        <item name="colorControlHighlight">#307743DB</item>
        <!-- Force light mode — never auto-switch to dark -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Light Alert Dialog -->
    <style name="LightAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">#1A1A2E</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="colorAccent">#7743DB</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonNegative</item>
    </style>

    <!-- Keep old name as alias so existing Java refs don't break -->
    <style name="DarkAlertDialog" parent="LightAlertDialog" />

    <style name="DialogButtonPositive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#7743DB</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogButtonNegative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#C3ACD0</item>
    </style>

</resources>
