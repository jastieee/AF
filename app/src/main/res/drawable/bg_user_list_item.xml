<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40C3ACD0" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#80C3ACD0" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#35C3ACD0" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#7743DB" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7EFE5" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#30C3ACD0" />
        </shape>
    </item>
</selector>
