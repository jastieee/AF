<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REGISTER BARCODE / ASSET TAG"
        android:textColor="#1A1A2E"
        android:textSize="18sp"
        android:fontFamily="@font/bebas_neue"
        android:letterSpacing="0.08" />

    <View
        android:layout_width="30dp"
        android:layout_height="2dp"
        android:background="#7743DB"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search for an untagged asset, then assign a barcode or asset tag number."
        android:textColor="#80443355"
        android:textSize="11sp"
        android:layout_marginBottom="14dp" />

    <!-- Search untagged asset -->
    <TextView style="@style/FieldLabel" android:text="SEARCH UNTAGGED ASSET" />
    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
        <EditText
            android:id="@+id/etRegisterSearch"
            style="@style/FieldInput"
            android:hint="Type asset name to search..."
            android:inputType="text" />
    </FrameLayout>

    <!-- Untagged asset picker -->
    <TextView style="@style/FieldLabel" android:text="SELECT ASSET" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="14dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
        <android.widget.Spinner
            android:id="@+id/spinnerUntagged"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="#F7EFE5" />
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30C3ACD0"
        android:layout_marginBottom="14dp" />

    <!-- Assign Barcode -->
    <TextView style="@style/FieldLabel" android:text="ASSIGN BARCODE (SCAN OR TYPE)" />
    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
        <EditText
            android:id="@+id/etRegisterBarcode"
            style="@style/FieldInput"
            android:hint="Scan barcode with Zebra scanner"
            android:imeOptions="actionNext"
            android:inputType="text" />
    </FrameLayout>

    <!-- Assign Asset Tag -->
    <TextView style="@style/FieldLabel" android:text="ASSIGN ASSET TAG NO. (e.g. AF-MNL-001)" />
    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="16dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
        <EditText
            android:id="@+id/etRegisterAssetTag"
            style="@style/FieldInput"
            android:hint="AF-CLUB-SEQ"
            android:inputType="text" />
    </FrameLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnRegisterCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textColor="#C3ACD0"
            android:textSize="12sp"
            android:fontFamily="@font/bebas_neue"
            android:background="@drawable/bg_perm_card_off"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRegisterSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="REGISTER"
            android:textColor="#FFFBF5"
            android:textSize="12sp"
            android:fontFamily="@font/bebas_neue"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>

</LinearLayout>
