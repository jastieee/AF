<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#209929EA" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#509929EA" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#259929EA" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#9929EA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#159929EA" />
        </shape>
    </item>
</selector>