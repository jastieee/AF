<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFBF5">

    <!-- ═══════════════════════════════════════════ -->
    <!--  MAIN CONTENT                              -->
    <!-- ═══════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFBF5">

        <!-- Ambient orb -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_orb_purple"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintDimensionRatio="1:1" />

        <!-- ─── HEADER ─── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFBF5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.13">

            <!-- Back button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#7743DB" />
            </FrameLayout>

            <!-- Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USER MANAGEMENT"
                    android:textColor="#1A1A2E"
                    android:textSize="17sp"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.12" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage accounts &amp; permissions"
                    android:textColor="#7743DB"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Right: count badge + menu toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- User count badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_badge_purple"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:id="@+id/tvUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#7743DB"
                        android:textSize="15sp"
                        android:fontFamily="@font/bebas_neue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" USERS"
                        android:textColor="#80443355"
                        android:textSize="10sp"
                        android:fontFamily="@font/bebas_neue"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- Hamburger menu -->
                <FrameLayout
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_btn"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        app:tint="#7743DB" />
                </FrameLayout>

            </LinearLayout>

            <!-- Bottom divider -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@drawable/bg_header_div"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ─── FULL WIDTH FORM ─── -->
        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/headerBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Form header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvFormTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREATE USER"
                        android:textColor="#1A1A2E"
                        android:textSize="20sp"
                        android:fontFamily="@font/bebas_neue"
                        android:letterSpacing="0.08" />
                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:background="#7743DB"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearForm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR FORM"
                    android:textColor="#80443355"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/bebas_neue"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Two-column form body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- ══════════════════════════════════════ -->
                <!--  LEFT: User fields                    -->
                <!-- ══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView style="@style/FieldLabel" android:text="FULL NAME" />
                    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <EditText
                            android:id="@+id/etFullName"
                            style="@style/FieldInput"
                            android:hint="e.g. Juan Dela Cruz"
                            android:inputType="textPersonName" />
                    </FrameLayout>

                    <TextView style="@style/FieldLabel" android:text="USERNAME" />
                    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <EditText
                            android:id="@+id/etUsername"
                            style="@style/FieldInput"
                            android:hint="e.g. jdelacruz"
                            android:inputType="text" />
                    </FrameLayout>

                    <TextView style="@style/FieldLabel" android:text="EMAIL ADDRESS" />
                    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <EditText
                            android:id="@+id/etEmail"
                            style="@style/FieldInput"
                            android:hint="email@example.com"
                            android:inputType="textEmailAddress" />
                    </FrameLayout>

                    <TextView style="@style/FieldLabel" android:text="ROLE" />
                    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <Spinner
                            android:id="@+id/spinnerRole"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:popupBackground="#F7EFE5" />
                    </FrameLayout>

                    <TextView style="@style/FieldLabel" android:text="PASSWORD" />
                    <FrameLayout style="@style/FieldWrap" android:layout_marginBottom="10dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <EditText
                            android:id="@+id/etPassword"
                            style="@style/FieldInput"
                            android:hint="Password"
                            android:inputType="textPassword" />
                    </FrameLayout>

                    <TextView style="@style/FieldLabel" android:text="CONFIRM PASSWORD" />
                    <FrameLayout style="@style/FieldWrap">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
                        <EditText
                            android:id="@+id/etConfirmPassword"
                            style="@style/FieldInput"
                            android:hint="Confirm password"
                            android:inputType="textPassword" />
                    </FrameLayout>

                </LinearLayout>

                <!-- ══════════════════════════════════════ -->
                <!--  RIGHT: Permissions + Actions         -->
                <!-- ══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODULE ACCESS PERMISSIONS"
                        android:textColor="#7743DB"
                        android:textSize="10sp"
                        android:letterSpacing="0.14"
                        android:fontFamily="@font/bebas_neue"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_perm_card_off">

                        <!-- Row: Inventory -->
                        <LinearLayout
                            android:id="@+id/permCardInventory"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_perm_row_selector">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inventory"
                                android:textColor="#1A1A2E"
                                android:textSize="13sp"
                                android:singleLine="true" />
                            <CheckBox
                                android:id="@+id/cbInventory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#7743DB"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#30C3ACD0" />

                        <!-- Row: Maintenance -->
                        <LinearLayout
                            android:id="@+id/permCardMaintenance"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_perm_row_selector">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Maintenance"
                                android:textColor="#1A1A2E"
                                android:textSize="13sp"
                                android:singleLine="true" />
                            <CheckBox
                                android:id="@+id/cbMaintenance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#7743DB"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#30C3ACD0" />

                        <!-- Row: Logs -->
                        <LinearLayout
                            android:id="@+id/permCardLogs"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_perm_row_selector">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Logs"
                                android:textColor="#1A1A2E"
                                android:textSize="13sp"
                                android:singleLine="true" />
                            <CheckBox
                                android:id="@+id/cbLogs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#7743DB"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#30C3ACD0" />

                        <!-- Row: User Management -->
                        <LinearLayout
                            android:id="@+id/permCardUserMgmt"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_perm_row_selector">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="User Management"
                                android:textColor="#1A1A2E"
                                android:textSize="13sp"
                                android:singleLine="true" />
                            <CheckBox
                                android:id="@+id/cbUserManagement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#7743DB"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnDelete"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="DELETE USER"
                            android:textColor="#FF6B6B"
                            android:textSize="11sp"
                            android:fontFamily="@font/bebas_neue"
                            android:letterSpacing="0.04"
                            android:background="@drawable/bg_btn_danger"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:text="SAVE USER"
                            android:textColor="#FFFBF5"
                            android:textSize="11sp"
                            android:fontFamily="@font/bebas_neue"
                            android:letterSpacing="0.04"
                            android:background="@drawable/bg_button_primary" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!--  DRAWER — User List                        -->
    <!-- ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_drawer_panels"
        android:padding="14dp">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ALL USERS"
                android:textColor="#7743DB"
                android:textSize="11sp"
                android:letterSpacing="0.16"
                android:fontFamily="@font/bebas_neue" />

            <FrameLayout
                android:id="@+id/btnCloseDrawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icon_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="#1A1A2E" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_input_field" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_search" app:tint="#7743DB" android:layout_marginEnd="7dp" />
                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search users..."
                    android:textColorHint="#80443355"
                    android:textColor="#1A1A2E"
                    android:textSize="12sp"
                    android:singleLine="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- User list -->
        <ListView
            android:id="@+id/listViewUsers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
